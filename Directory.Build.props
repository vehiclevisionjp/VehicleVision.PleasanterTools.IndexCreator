<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig の IDE 規則（{} の省略禁止など）を、ビルドで強制する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.4.0</Version>
    <Company>PMC Co., Ltd. IT Solution Div.</Company>
    <Authors>PMC Co., Ltd. IT Solution Div.</Authors>
    <Copyright>Copyright (C) PMC Co., Ltd. IT Solution Div.</Copyright>
    <!-- デュアルライセンス（AGPL-3.0-or-later OR 商用）。LICENSING.md を参照。
         NuGet の PackageLicenseExpression は LicenseRef-* を含む式を受け付けないため、式は持たない -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
